---
// GPU-drawn generative field behind the home opening. A hand-written WebGL
// fragment shader (no library): domain-warped fBm flow, quantised into
// dithered bands in the theme's own palette, warping toward the cursor. The
// canvas is purely decorative (pointer-events: none) and sits behind the text,
// which keeps its own legibility scrim.
//
// Degrades cleanly: no WebGL / Save-Data / a lost context all fall back to the
// CSS gradient in `.opening--static`; prefers-reduced-motion renders a single
// still frame instead of animating.
---
<div class="opening__bg" aria-hidden="true">
  <canvas data-shader-hero></canvas>
</div>

<script>
  const VERT = `
    attribute vec2 a_pos;
    varying vec2 v_uv;
    void main() {
      v_uv = a_pos * 0.5 + 0.5;
      gl_Position = vec4(a_pos, 0.0, 1.0);
    }
  `;

  const FRAG = `
    precision highp float;
    uniform vec2 u_res;
    uniform float u_time;
    uniform vec2 u_pointer;
    uniform float u_reveal;
    uniform vec3 u_bg;
    uniform vec3 u_soft;
    uniform vec3 u_accent;
    varying vec2 v_uv;

    float hash(vec2 p) {
      p = fract(p * vec2(123.34, 456.21));
      p += dot(p, p + 45.32);
      return fract(p.x * p.y);
    }
    float noise(vec2 p) {
      vec2 i = floor(p), f = fract(p);
      float a = hash(i), b = hash(i + vec2(1.0, 0.0));
      float c = hash(i + vec2(0.0, 1.0)), d = hash(i + vec2(1.0, 1.0));
      vec2 u = f * f * (3.0 - 2.0 * f);
      return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
    }
    float fbm(vec2 p) {
      float v = 0.0, a = 0.5;
      mat2 m = mat2(1.6, 1.2, -1.2, 1.6);
      for (int i = 0; i < 5; i++) { v += a * noise(p); p = m * p; a *= 0.5; }
      return v;
    }
    // Interleaved gradient noise — a cheap ordered dither threshold.
    float ign(vec2 p) {
      return fract(52.9829189 * fract(0.06711056 * p.x + 0.00583715 * p.y));
    }

    void main() {
      vec2 uv = v_uv;
      float asp = u_res.x / max(u_res.y, 1.0);
      vec2 p = vec2(uv.x * asp, uv.y) * 2.4;
      float t = u_time * 0.06;

      // Two levels of domain warp → slow, organic "ink in water" flow.
      vec2 q = vec2(fbm(p + t), fbm(p + vec2(5.2, 1.3) - t));
      vec2 r = vec2(
        fbm(p + 2.0 * q + vec2(1.7, 9.2) + 0.10 * t),
        fbm(p + 2.0 * q + vec2(8.3, 2.8) - 0.08 * t)
      );
      float f = fbm(p + 2.6 * r);

      // Cursor pulls the field toward it.
      vec2 pt = vec2(u_pointer.x * asp, u_pointer.y);
      float pd = distance(vec2(uv.x * asp, uv.y), pt);
      f += 0.18 * smoothstep(0.6, 0.0, pd) * sin(u_time * 0.7 - pd * 10.0);
      f = clamp(f * 0.5 + 0.5, 0.0, 1.0);

      // Quantise into dithered bands — the refined "designed" texture.
      float levels = 6.0;
      float d = ign(gl_FragCoord.xy);
      float fb = floor(f * levels + d) / levels;

      // Map through the palette, kept light so the text stays readable.
      vec3 col = mix(u_bg, u_soft, smoothstep(0.15, 0.7, fb));
      col = mix(col, u_accent, smoothstep(0.72, 1.0, fb) * 0.85);
      col = mix(u_bg, col, 0.62 * u_reveal);

      // Fine ordered grain — the tactile, "printed" texture that reads as
      // designed rather than a smooth gradient. Behind the scrim, so it never
      // touches the text.
      col += (d - 0.5) * 0.03;

      gl_FragColor = vec4(col, 1.0);
    }
  `;

  function parseColor(str: string): [number, number, number] {
    str = str.trim();
    if (str[0] === "#") {
      let h = str.slice(1);
      if (h.length === 3) h = h.split("").map((c) => c + c).join("");
      const n = parseInt(h, 16);
      return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
    }
    const m = str.match(/[\d.]+/g);
    if (m && m.length >= 3) return [+m[0] / 255, +m[1] / 255, +m[2] / 255];
    return [1, 1, 1];
  }

  function initShaderHero(): void {
    const canvas = document.querySelector<HTMLCanvasElement>("canvas[data-shader-hero]");
    if (!canvas || canvas.dataset.inited) return;
    const hero = (canvas.closest<HTMLElement>(".opening") ?? canvas.parentElement)!;

    const conn = (navigator as { connection?: { saveData?: boolean } }).connection;
    if (conn?.saveData) {
      hero.classList.add("opening--static");
      return;
    }

    let gl: WebGLRenderingContext | null = null;
    try {
      const opts = { antialias: false, alpha: false, depth: false, powerPreference: "low-power" };
      gl =
        (canvas.getContext("webgl", opts) as WebGLRenderingContext | null) ??
        (canvas.getContext("experimental-webgl", opts) as WebGLRenderingContext | null);
    } catch {
      gl = null;
    }
    if (!gl) {
      hero.classList.add("opening--static");
      return;
    }
    canvas.dataset.inited = "1";
    const ctx = gl;

    const compile = (type: number, src: string): WebGLShader | null => {
      const sh = ctx.createShader(type)!;
      ctx.shaderSource(sh, src);
      ctx.compileShader(sh);
      return ctx.getShaderParameter(sh, ctx.COMPILE_STATUS) ? sh : null;
    };
    const vs = compile(ctx.VERTEX_SHADER, VERT);
    const fs = compile(ctx.FRAGMENT_SHADER, FRAG);
    const prog = ctx.createProgram()!;
    if (!vs || !fs) {
      hero.classList.add("opening--static");
      return;
    }
    ctx.attachShader(prog, vs);
    ctx.attachShader(prog, fs);
    ctx.linkProgram(prog);
    if (!ctx.getProgramParameter(prog, ctx.LINK_STATUS)) {
      hero.classList.add("opening--static");
      return;
    }
    ctx.useProgram(prog);

    const buf = ctx.createBuffer();
    ctx.bindBuffer(ctx.ARRAY_BUFFER, buf);
    ctx.bufferData(ctx.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), ctx.STATIC_DRAW);
    const loc = ctx.getAttribLocation(prog, "a_pos");
    ctx.enableVertexAttribArray(loc);
    ctx.vertexAttribPointer(loc, 2, ctx.FLOAT, false, 0, 0);

    const U = {
      res: ctx.getUniformLocation(prog, "u_res"),
      time: ctx.getUniformLocation(prog, "u_time"),
      pointer: ctx.getUniformLocation(prog, "u_pointer"),
      reveal: ctx.getUniformLocation(prog, "u_reveal"),
      bg: ctx.getUniformLocation(prog, "u_bg"),
      soft: ctx.getUniformLocation(prog, "u_soft"),
      accent: ctx.getUniformLocation(prog, "u_accent"),
    };

    // Feed the theme's own design tokens to the shader, so a recolouring preset
    // (e.g. the dark skin) recolours the field too.
    const cs = getComputedStyle(document.documentElement);
    const css = (name: string) => cs.getPropertyValue(name);
    ctx.uniform3fv(U.bg, parseColor(css("--color-bg") || "#ffffff"));
    ctx.uniform3fv(U.soft, parseColor(css("--color-accent-soft") || "#dbeafe"));
    ctx.uniform3fv(U.accent, parseColor(css("--color-accent") || "#1e3a8a"));

    let w = 0;
    let h = 0;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const resize = () => {
      const rect = hero.getBoundingClientRect();
      w = Math.max(1, Math.round(rect.width * dpr));
      h = Math.max(1, Math.round(rect.height * dpr));
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
        ctx.viewport(0, 0, w, h);
      }
    };
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(hero);

    // Pointer, smoothed. Defaults to the centre so an untouched page still has a
    // gentle focal point.
    const target: [number, number] = [0.5, 0.55];
    const cur: [number, number] = [0.5, 0.55];
    const onPointer = (e: PointerEvent) => {
      const rect = hero.getBoundingClientRect();
      target[0] = (e.clientX - rect.left) / rect.width;
      target[1] = 1 - (e.clientY - rect.top) / rect.height;
    };
    window.addEventListener("pointermove", onPointer, { passive: true });

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let raf = 0;
    let start = 0;
    let visible = true;

    const frame = (now: number) => {
      raf = 0;
      if (!start) start = now;
      const time = (now - start) / 1000;

      cur[0] += (target[0] - cur[0]) * 0.06;
      cur[1] += (target[1] - cur[1]) * 0.06;

      // Fade + release as the hero scrolls away (cheap, per-frame).
      const rect = hero.getBoundingClientRect();
      const prog01 = Math.min(1, Math.max(0, 1 + rect.top / rect.height));
      canvas.style.opacity = String(prog01);

      ctx.uniform2f(U.res, w, h);
      ctx.uniform1f(U.time, time);
      ctx.uniform2f(U.pointer, cur[0], cur[1]);
      ctx.uniform1f(U.reveal, Math.min(1, time / 1.2));
      ctx.drawArrays(ctx.TRIANGLES, 0, 3);

      if (visible && !reduce) raf = requestAnimationFrame(frame);
    };

    const stop = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    };
    const play = () => {
      if (!raf && visible) raf = requestAnimationFrame(frame);
    };

    if (reduce) {
      // One still frame, fully revealed — no animation loop.
      start = -1200;
      requestAnimationFrame(frame);
    } else {
      // Only run while the hero is actually on screen and the tab is focused.
      const io = new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          visible ? play() : stop();
        },
        { threshold: 0 },
      );
      io.observe(hero);
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stop();
        else play();
      });
    }

    canvas.addEventListener("webglcontextlost", (e) => {
      e.preventDefault();
      stop();
      hero.classList.add("opening--static");
    });

    // Tear down before a View-Transitions swap so nothing leaks across pages.
    document.addEventListener(
      "astro:before-swap",
      () => {
        stop();
        ro.disconnect();
        window.removeEventListener("pointermove", onPointer);
      },
      { once: true },
    );
  }

  if (document.readyState !== "loading") initShaderHero();
  else document.addEventListener("DOMContentLoaded", initShaderHero);
  // Harmless until View Transitions are enabled; ready for it when they are.
  document.addEventListener("astro:page-load", initShaderHero);
</script>
