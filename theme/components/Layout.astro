---
import options from "virtual:cosense-theme-lab/options";
import site from "virtual:cosense-site-kit/site";
import Header from "./Header.astro";
import Intro from "./Intro.astro";
import Footer from "./Footer.astro";
import TableOfContents from "./TableOfContents.astro";
import CodeBlockEnhancer from "./CodeBlockEnhancer.astro";
import LinkPreview from "./LinkPreview.astro";
import SearchOverlay from "./SearchOverlay.astro";
import Interactions from "./Interactions.astro";
import BackToTop from "./BackToTop.astro";
import LogoMark from "./LogoMark.astro";
import KaTeXLink from "@cosense-site-kit/theme-utils/components/KaTeXLink.astro";
import { loadStructure, path } from "@cosense-site-kit/theme-utils";
import { resolveActiveSkin } from "../presets";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Use the wide page width (e.g. members grids). */
  wide?: boolean;
  /**
   * Drop the main column's width cap and padding, letting the page own its own
   * layout. Used by the home page, whose photo grid runs edge to edge.
   */
  bare?: boolean;
  /** Hide the floating right-side TOC (use on home / list pages). */
  hideToc?: boolean;
  /** Hide the site footer (use on the single-screen home portal). */
  hideFooter?: boolean;
  /** OG/Twitter card image (absolute or site-relative). Falls back to favicon. */
  image?: string;
  /** OpenGraph type. "article" for content pages, "website" for indexes. */
  ogType?: "website" | "article";
  /** Cosense page this view comes from; linked from the site footer. */
  sourceUrl?: string;
}

const {
  title,
  description,
  wide = false,
  bare = false,
  hideToc = false,
  hideFooter = false,
  image,
  ogType = "website",
  sourceUrl,
} = Astro.props;

const siteTitle =
  options.siteTitle ??
  site?.title ??
  (Astro.site ? new URL("/", Astro.site).hostname : title);
const fullTitle = siteTitle && siteTitle !== title ? `${title} | ${siteTitle}` : title;
const metaDescription = description ?? options.siteDescription ?? site?.description ?? "";
const lang = site?.lang ?? "ja";

// SEO/social. canonical + og:url come from the current path against the
// configured site origin; og:image resolves to absolute (page image, else the
// favicon). Built here so every template that uses Layout gets cards for free.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Favicon: theme option wins over the framework's `.site`-resolved icon.
const faviconBase = options.favicon ?? site?.icon;
// Browsers cache favicons separately and stubbornly (a reload doesn't
// refresh them), so a local favicon gets a version in its URL — bump
// FAVICON_VERSION after replacing the file to make every browser fetch it again.
const FAVICON_VERSION = "2";
const faviconHref =
  faviconBase && faviconBase.startsWith("/") ? `${faviconBase}?v=${FAVICON_VERSION}` : faviconBase;
const imageSrc = image ?? faviconHref;
const ogImage = imageSrc && Astro.site ? new URL(imageSrc, Astro.site).href : imageSrc;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": ogType === "article" ? "Article" : "WebSite",
  name: title,
  headline: title,
  ...(metaDescription ? { description: metaDescription } : {}),
  ...(canonical ? { url: canonical } : {}),
  ...(ogImage ? { image: ogImage } : {}),
};

// Preset (skin) support. The active skin comes from `.site` YAML `theme.skin`
// (operator-controlled, switchable in Cosense with no repo edit) and falls back
// to the preset wired in astro.config.ts. Token overrides go on the <html>
// inline style so they beat the :root defaults in global.css regardless of
// stylesheet order; fonts are preset-driven (they load via a <link>).
const structure = await loadStructure();
const { tokens, colorScheme, fontHref } = resolveActiveSkin(structure.theme?.skin, options);
// Only advertise the feed when the site actually declares a posts tag.
const hasFeed = Boolean(structure.posts?.tag);
const htmlStyle = [
  colorScheme ? `color-scheme:${colorScheme}` : null,
  ...Object.entries(tokens).map(([k, v]) => `${k}:${v}`),
]
  .filter(Boolean)
  .join(";");
---
<!doctype html>
<html lang={lang} data-theme={colorScheme ?? undefined} style={htmlStyle || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {metaDescription && <meta name="description" content={metaDescription} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {faviconHref && <link rel="icon" href={faviconHref} />}
    {options.favicon && <link rel="apple-touch-icon" href={faviconHref} />}
    {hasFeed && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={`${siteTitle} feed`}
        href={path("feed.xml")}
      />
    )}

    {/* OpenGraph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:site_name" content={siteTitle} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}

    {/* Twitter card — only go large when the page has its own image (not the
        favicon fallback), otherwise a small summary card. */}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    {metaDescription && <meta name="twitter:description" content={metaDescription} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    {/* Japanese-first web fonts: M PLUS 2 body, Shippori Mincho serif display
        headings, M PLUS 1 Code mono — paired with the --font-* tokens in
        styles/global.css. Loaded for every skin; a preset can still layer an
        extra face via fontHref (pair it with --font-* token overrides). */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=M+PLUS+1+Code:wght@400;500&family=M+PLUS+2:wght@400;500;600;700&family=Shippori+Mincho:wght@600;700&display=swap"
      rel="stylesheet"
    />
    {fontHref && <link href={fontHref} rel="stylesheet" />}
    <KaTeXLink />
    <title>{fullTitle}</title>
    <script is:inline>
      // Broken images → the lab's logo mark. Registered in <head> (capture
      // phase, since image errors don't bubble) so it catches every failure,
      // even ones that happen before the page finishes parsing. The failed
      // <img> is swapped for a placeholder that keeps its classes (so sized
      // slots — avatars, thumbnails, gallery tiles — keep their shape) and
      // shows the mark from <template id="img-fallback-tpl"> at the end of
      // <body>. Skipped: the header logo (own fallback), inline icons, and
      // /gallery photos (that page drops a broken photo and recounts).
      (function () {
        var SKIP = ".site-logo, .icon, .inline-image, .pin__cell img";
        function swap(img) {
          if (!img.isConnected || img.dataset.fallback) return;
          img.dataset.fallback = "1";
          var tpl = document.getElementById("img-fallback-tpl");
          if (!tpl) return; // not parsed yet: picked up at DOMContentLoaded
          var ph = document.createElement("span");
          ph.className = (img.className ? img.className + " " : "") + "img-fallback";
          ph.setAttribute("role", "img");
          ph.setAttribute("aria-label", img.alt || "");
          var w = img.getAttribute("width"), h = img.getAttribute("height");
          if (w && h) ph.style.aspectRatio = w + " / " + h;
          ph.appendChild(tpl.content.cloneNode(true));
          img.replaceWith(ph);
        }
        function check(img) {
          if (img.matches(SKIP)) return;
          if (!img.getAttribute("src") && !img.getAttribute("srcset")) return;
          swap(img);
        }
        document.addEventListener(
          "error",
          function (e) {
            var t = e.target;
            if (t && t.tagName === "IMG") {
              t.removeAttribute("data-fallback");
              check(t);
            }
          },
          true,
        );
        document.addEventListener("DOMContentLoaded", function () {
          document.querySelectorAll("img").forEach(function (img) {
            if (img.dataset.fallback === "1" && img.isConnected) {
              img.removeAttribute("data-fallback");
              check(img);
            } else if (img.complete && img.naturalWidth === 0 && img.getAttribute("src")) {
              check(img);
            }
          });
        });
      })();
    </script>
  </head>
  <body>
    <Intro />
    <Header currentPath={Astro.url.pathname} />
    {options.search && <SearchOverlay />}
    <main class:list={["site-main", { wide, bare }]}>
      <slot />
    </main>
    {!hideFooter && <Footer sourceUrl={sourceUrl} />}
    {/* On every page; it removes itself when the page fits on one screen or
        has no section headings. (`hideToc` is kept for compatibility.) */}
    <TableOfContents />
    <CodeBlockEnhancer />
    <LinkPreview />
    <Interactions />
    <BackToTop />
    <template id="img-fallback-tpl"><LogoMark class="img-fallback__mark" /></template>
  </body>
</html>
