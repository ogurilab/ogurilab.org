---
// Body-level search panel, opened from the header search icon: a dim,
// blurred backdrop over the page and a centred panel with a "SEARCH" label
// and the Pagefind UI (lazy-loaded into #cosense-search by the header script,
// reading data-bundle-path). bundlePath is resolved against BASE_URL so it
// works under a sub-path.

const bundlePath = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/pagefind/`;
---
<div class="search-overlay" id="site-search-overlay" data-bundle-path={bundlePath} data-pagefind-ignore>
  <div class="search-overlay-backdrop"></div>
  <div class="search-box" role="dialog" aria-modal="true" aria-label="サイト内検索">
    <div class="search-box__head">
      <span class="search-box__eyebrow">Search</span>
    </div>
    <div id="cosense-search"></div>
    <p class="search-box-note" hidden>
      検索はサイトをビルドすると使えるようになります（<code>npm run build</code> → <code>npm run preview</code>）。
    </p>
  </div>
</div>
