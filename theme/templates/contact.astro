---
// Contact page. Reads the Cosense "Contact" page and lays it out as:
//   - a header ("CONTACT" eyebrow, title, Japanese subtitle),
//   - the first section as the main enquiry block: its text, then each
//     contact route (email / X / university desk / other links found in the
//     indented lines) as a large card with an icon — email gets a copy button,
//   - every later section (donations, gifts for students…) as a numbered
//     "support" card side by side, with its links as buttons.
// Sections are split on Cosense headings ([**** …]), so editing the page in
// Cosense reflows this layout with no code change.
import type { CollectionEntry } from "astro:content";
import type { CosenseBlock, InlineNode } from "@cosense-site-kit/core";
import Layout from "../components/Layout.astro";
import { inlineText } from "../lib/content";

interface Props {
  entry: CollectionEntry<"pages">;
}
const { entry } = Astro.props;
const page = entry.data;

type Kind = "mail" | "x" | "university" | "gift" | "link";
interface Way {
  kind: Kind;
  label: string;
  value: string;
  href: string;
}
interface Section {
  title: string;
  paragraphs: string[];
  ways: Way[];
}

const EMAIL = /[\w.+-]+@[\w-]+(\.[\w-]+)+/;
const stripEmoji = (s: string) => s.replace(/[\p{Extended_Pictographic}️]/gu, "").trim();
const hostOf = (href: string) => {
  try {
    return new URL(href).hostname.replace(/^www\./, "");
  } catch {
    return href;
  }
};
const kindOf = (href: string): Kind => {
  const h = hostOf(href);
  if (href.startsWith("mailto:")) return "mail";
  if (/(^|\.)(x|twitter)\.com$/.test(h)) return "x";
  if (/\.ac\.jp$/.test(h)) return "university";
  if (/amazon\./.test(h)) return "gift";
  return "link";
};

/** Contact routes found in one line: its links, or a bare email address. */
function waysIn(nodes: InlineNode[]): Way[] {
  const ways: Way[] = [];
  const walk = (ns: InlineNode[]) => {
    for (const n of ns) {
      if (n.type === "link") {
        const text = stripEmoji(inlineText(n.children)) || n.href;
        const kind = kindOf(n.href);
        // Long university labels ("愛知工業大学 共同研究・…の案内"): name on top, rest below.
        const sp = text.search(/[\s　]/);
        if (kind === "university" && text.length > 14 && sp > 0) {
          ways.push({ kind, label: text.slice(0, sp), value: text.slice(sp).trim(), href: n.href });
          continue;
        }
        ways.push({
          kind,
          label: kind === "x" ? "X (Twitter)" : text,
          value: kind === "x" ? (text.startsWith("@") ? text : `@${hostOf(n.href)}`) : hostOf(n.href),
          href: n.href,
        });
      } else if ("children" in n && Array.isArray(n.children)) {
        walk(n.children as InlineNode[]);
      }
    }
  };
  walk(nodes);
  if (ways.length === 0) {
    const mail = inlineText(nodes).match(EMAIL)?.[0];
    if (mail) ways.push({ kind: "mail", label: "メール", value: mail, href: `mailto:${mail}` });
  }
  return ways;
}

const sections: Section[] = [];
let current: Section | null = null;
for (const b of page.blocks as CosenseBlock[]) {
  if (b.type === "heading") {
    current = { title: inlineText(b.children).trim(), paragraphs: [], ways: [] };
    sections.push(current);
    continue;
  }
  if (!current) continue; // anything before the first heading (the title line)
  // the page's own tag line (#publish #no-date) isn't content
  if (b.type === "paragraph" && b.children.every((n) => n.type === "tag" || (n.type === "text" && !n.value.trim())))
    continue;
  if (b.type === "paragraph") {
    const found = waysIn(b.children);
    const text = inlineText(b.children).trim();
    if (found.length > 0 && (EMAIL.test(text) ? text === found[0].value : false)) {
      current.ways.push(...found);
    } else if (text) {
      current.paragraphs.push(text);
    }
  } else if (b.type === "list") {
    current.ways.push(...waysIn(b.children));
  }
}
const [primary, ...supports] = sections;

// A simple icon for each section, picked from its title / links.
type Topic = "chat" | "heart" | "gift" | "handshake" | "pin" | "info";
const topicOf = (s: Section): Topic => {
  const t = s.title;
  if (/寄付|寄附|支援|donat|support/i.test(t)) return "heart";
  if (/ギフト|プレゼント|贈|欲しい|wish|gift/i.test(t) || s.ways.some((w) => w.kind === "gift")) return "gift";
  if (/共同|連携|企業|協力|collab/i.test(t)) return "handshake";
  if (/見学|訪問|アクセス|場所|access|visit/i.test(t)) return "pin";
  return "info";
};
const no = (i: number) => String(i + 1).padStart(2, "0");
// Most direct routes first: email, then X, then the university desk, then the rest.
const ORDER: Kind[] = ["mail", "x", "university", "gift", "link"];
primary?.ways.sort((a, b) => ORDER.indexOf(a.kind) - ORDER.indexOf(b.kind));
---
<Layout title={page.title} sourceUrl={page.sourceUrl} description={page.summary} image={page.image} wide hideToc>
  <article class="contact" data-pagefind-body>
    <header class="contact__head">
      <p class="contact__eyebrow">Contact</p>
      <h1 class="contact__title">お問い合わせ</h1>
    </header>

    {primary && (
      <section class="contact__primary">
        <div class="contact-sec">
          <span class="contact-sec__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4A1.5 1.5 0 0 1 4 14.5z" /><path d="M8.5 9h7M8.5 12h4.5" /></svg>
          </span>
          <div>
            <p class="contact-sec__no">{no(0)}</p>
            <h2 class="contact-sec__title">{primary.title}</h2>
          </div>
        </div>
        <div class="contact__lead">
          {primary.paragraphs.map((p) => <p>{p}</p>)}
        </div>

        {primary.ways.length > 0 && (
          <ul class="contact__ways">
            {primary.ways.map((w) => (
              <li class="contact-way" data-kind={w.kind}>
                <a
                  class="contact-way__link"
                  href={w.href}
                  {...(w.kind === "mail" ? {} : { target: "_blank", rel: "noopener noreferrer" })}
                >
                  <span class="contact-way__icon" aria-hidden="true">
                    {w.kind === "mail" && (
                      <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></svg>
                    )}
                    {w.kind === "x" && (
                      <svg class="is-filled" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
                    )}
                    {w.kind === "university" && (
                      <svg viewBox="0 0 24 24"><path d="M3 9.5 12 4l9 5.5M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3.5 20h17" /></svg>
                    )}
                    {(w.kind === "gift" || w.kind === "link") && (
                      <svg viewBox="0 0 24 24"><path d="M10 14 20 4M14 4h6v6M18 13.5V19a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5.5" /></svg>
                    )}
                  </span>
                  <span class="contact-way__label">{w.label}</span>
                  <span class="contact-way__value">
                    {w.kind === "mail" && w.value.includes("@") ? (
                      <Fragment>{w.value.split("@")[0]}@<wbr />{w.value.split("@").slice(1).join("@")}</Fragment>
                    ) : (
                      w.value
                    )}
                  </span>
                  <span class="contact-way__arrow" aria-hidden="true">{w.kind === "mail" ? "→" : "↗"}</span>
                </a>
                {w.kind === "mail" && (
                  <button type="button" class="contact-way__copy" data-copy={w.value}>
                    <span class="contact-way__copy-label">コピー</span>
                  </button>
                )}
              </li>
            ))}
          </ul>
        )}
      </section>
    )}

    {supports.length > 0 && (
      <div class="contact__supports">
        {supports.map((s, i) => (
          <section class="contact-support">
            <div class="contact-sec contact-sec--card">
              <span class="contact-sec__icon" aria-hidden="true">
                {topicOf(s) === "heart" && (
                  <svg viewBox="0 0 24 24"><path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20z" /></svg>
                )}
                {topicOf(s) === "gift" && (
                  <svg viewBox="0 0 24 24"><rect x="4" y="9" width="16" height="11" rx="1.5" /><path d="M3 9h18M12 9v11M12 9c-1.5-3.5-5.5-4-5.5-1.5S10 9 12 9zM12 9c1.5-3.5 5.5-4 5.5-1.5S14 9 12 9z" /></svg>
                )}
                {topicOf(s) === "handshake" && (
                  <svg viewBox="0 0 24 24"><circle cx="9" cy="12" r="4.5" /><circle cx="15" cy="12" r="4.5" /></svg>
                )}
                {topicOf(s) === "pin" && (
                  <svg viewBox="0 0 24 24"><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.3" /></svg>
                )}
                {topicOf(s) === "info" && (
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" /><path d="M12 11v5M12 8h.01" /></svg>
                )}
              </span>
              <div>
                <p class="contact-sec__no">{no(i + 1)}</p>
                <h2 class="contact-sec__title">{s.title}</h2>
              </div>
            </div>
            {s.paragraphs.map((p) => <p class="contact-support__text">{p}</p>)}
            {s.ways.length > 0 && (
              <div class="contact-support__links">
                {s.ways.map((w) => (
                  <a class="contact-support__link" href={w.href} target="_blank" rel="noopener noreferrer">
                    {w.kind === "gift" && (
                      <svg class="contact-support__link-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="9" width="16" height="11" rx="1.5" /><path d="M3 9h18M12 9v11M12 9c-1.5-3.5-5.5-4-5.5-1.5S10 9 12 9zM12 9c1.5-3.5 5.5-4 5.5-1.5S14 9 12 9z" /></svg>
                    )}
                    {w.kind === "mail" && (
                      <svg class="contact-support__link-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></svg>
                    )}
                    <span>{w.label}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            )}
          </section>
        ))}
      </div>
    )}
  </article>
</Layout>

<script>
  // Copy-to-clipboard for the email card.
  document.querySelectorAll<HTMLButtonElement>(".contact-way__copy").forEach((btn) => {
    const label = btn.querySelector<HTMLElement>(".contact-way__copy-label");
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        btn.classList.add("is-copied");
        if (label) label.textContent = "コピーしました";
        window.setTimeout(() => {
          btn.classList.remove("is-copied");
          if (label) label.textContent = "コピー";
        }, 1600);
      } catch {
        /* clipboard blocked: the mailto link still works */
      }
    });
  });
</script>

<style>
  .contact__head { margin-bottom: clamp(2rem, 5vw, 3rem); }
  .contact__eyebrow {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .contact__title {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.2;
  }

  /* Main enquiry block */
  .contact__primary {
    padding-bottom: clamp(2.5rem, 6vw, 3.5rem);
    margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
    border-bottom: 1px solid var(--color-border);
  }
  /* Section heading: icon badge + number + title (same for 01, 02, 03…) */
  .contact-sec {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1rem;
  }
  .contact-sec__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
  .contact-sec__icon svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .contact-sec__no {
    margin: 0 0 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-accent-bright);
  }
  .contact-sec__title {
    margin: 0;
    font-size: clamp(1.125rem, 2.4vw, 1.375rem);
    line-height: 1.4;
  }
  .contact-sec--card .contact-sec__title { font-size: 1.0625rem; }
  .contact-sec--card { margin-bottom: 0.9rem; }

  .contact__lead {
    max-width: 44rem;
    color: var(--color-text-soft);
    line-height: 1.9;
  }
  .contact__lead p { margin: 0 0 0.6rem; }

  /* Contact routes as large cards */
  .contact__ways {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }
  .contact-way { position: relative; }
  .contact-way__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      "icon label arrow"
      "icon value arrow";
    grid-template-rows: auto auto;
    align-items: center;
    align-content: center;
    column-gap: 1rem;
    row-gap: 0.2rem;
    height: 100%;
    padding: 1.25rem 1.25rem 1.25rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease),
      translate 0.2s var(--ease);
  }
  .contact-way__link:hover {
    border-color: var(--color-accent-bright);
    box-shadow: 0 14px 30px -14px rgb(34 38 38 / 0.25);
    translate: 0 -2px;
  }
  .contact-way__icon {
    grid-area: icon;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius);
    background: var(--color-text);
    color: var(--color-bg);
    transition: background 0.2s var(--ease);
  }
  .contact-way__link:hover .contact-way__icon { background: var(--color-accent-bright); }
  .contact-way__icon svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .contact-way__icon svg.is-filled {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
    stroke: none;
  }
  .contact-way__label {
    grid-area: label;
    align-self: end;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .contact-way__value {
    grid-area: value;
    align-self: start;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    overflow-wrap: break-word;
  }
  .contact-way[data-kind="university"] .contact-way__value {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1.6;
  }
  .contact-way__arrow {
    grid-area: arrow;
    font-size: 1.1rem;
    color: var(--color-text-faint);
    transition: color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .contact-way__link:hover .contact-way__arrow {
    color: var(--color-accent);
    transform: translate(2px, -2px);
  }
  /* Email: room for the copy button on the right */
  .contact-way[data-kind="mail"] .contact-way__link { padding-right: 6.5rem; }
  .contact-way[data-kind="mail"] .contact-way__arrow { display: none; }
  .contact-way__copy {
    position: absolute;
    top: 50%;
    right: 1rem;
    transform: translateY(-50%);
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-text-soft);
    cursor: pointer;
    transition: border-color 0.15s var(--ease), color 0.15s var(--ease), background 0.15s var(--ease);
  }
  .contact-way__copy:hover { border-color: var(--color-text-faint); color: var(--color-text); }
  .contact-way__copy.is-copied {
    background: var(--color-accent-soft);
    border-color: var(--color-accent-bright);
    color: var(--color-accent);
  }

  /* Support sections: numbered cards side by side */
  .contact__supports {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1rem;
  }
  .contact-support {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.5rem 1.4rem;
    border-radius: var(--radius-lg);
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border-soft);
  }
  .contact-support__text {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
    line-height: 1.8;
    color: var(--color-text-soft);
  }
  .contact-support__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }
  .contact-support__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius);
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s var(--ease);
  }
  .contact-support__link:hover { background: var(--color-accent); text-decoration: none; }
  .contact-support__link-icon {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
