---
import { getCollection } from "astro:content";
import options from "virtual:cosense-theme-lab/options";
import Layout from "../components/Layout.astro";
import YearJump from "../components/YearJump.astro";
import { hasTag, loadStructure, path } from "@cosense-site-kit/theme-utils";
import { allPhotosFrom, responsiveImage, type Photo } from "../lib/photos";
import { newsSummary } from "../lib/news";
import { aspectRatios, gyazoId } from "../lib/gyazo";

// The gallery: one white sheet (same width as the other wide pages) holding
// the lab's photos as an album — every image from the news posts (block and
// inline images alike), grouped by year, newest first. Each photo keeps its own aspect ratio (no cropping), shows the post
// it came from on hover, and links to that post. A row of year chips at the
// top jumps between years.

const structure = await loadStructure();
const newsTag = structure.posts?.tag ?? options.newsTag;
const all = await getCollection("pages");

interface Shot extends Photo {
  title: string;
  /** "MM.DD" of the source post, when known */
  day?: string;
}
interface Group {
  id: string;
  label: string;
  sub?: string;
  shots: Shot[];
}

// one photo appears once, at its first (newest) use
const seen = new Set<string>();
const fresh = (p: Photo) => {
  const key = gyazoId(p.src) ?? p.src;
  if (seen.has(key)) return false;
  seen.add(key);
  return true;
};

const groups: Group[] = [];

const posts = all
  .filter((e) => hasTag(e.data.tags, newsTag))
  .map((e) => ({ e, n: newsSummary(e) }))
  .sort((a, b) => (b.n.date?.getTime() ?? 0) - (a.n.date?.getTime() ?? 0));
const byYear = new Map<string, Shot[]>();
for (const { e, n } of posts) {
  const year = n.date ? String(n.date.getFullYear()) : "—";
  const day = n.date
    ? `${String(n.date.getMonth() + 1).padStart(2, "0")}.${String(n.date.getDate()).padStart(2, "0")}`
    : undefined;
  const shots = allPhotosFrom(e.data.blocks)
    .filter(fresh)
    .map((p) => ({ ...p, alt: p.alt || n.title, href: p.href ?? path(e.data.slug), title: n.title, day }));
  if (shots.length === 0) continue;
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(...shots);
}
for (const [year, shots] of byYear) {
  groups.push({ id: year === "—" ? "undated" : `y${year}`, label: year === "—" ? "Undated" : year, shots });
}

const total = groups.reduce((n, g) => n + g.shots.length, 0);

// Per-image aspect ratios so each tile reserves the right height before it
// loads (a failed lookup falls back to 4:3).
const flat = groups.flatMap((g) => g.shots);
const ratios = await aspectRatios(flat.map((p) => p.src));
const ratioOf = new Map(flat.map((p, i) => [p, ratios[i] ?? 4 / 3]));

// Tiles are only ~250px wide (≈500px on a 2x screen), so ask Gyazo for
// 320/640px files instead of the 960–1600px ones used for full-size images.
// (Not re-encoded at build time like the home strips: fetching all ~300
// photos in one build makes Gyazo answer 503 and the build fails.)
const small = (p: Photo): Photo => {
  if (/gyazo\.com\//.test(p.src)) return { ...p, ...responsiveImage(p.src, [320, 640]) };
  if (/^https:\/\/wsrv\.nl\//.test(p.src)) {
    const at = (w: number) => p.src.replace(/([?&])w=\d+/, `$1w=${w}`);
    return { ...p, src: at(640), srcset: `${at(320)} 320w, ${at(640)} 640w` };
  }
  return p;
};
const tileOf = new Map<Photo, Photo>(flat.map((p) => [p, small(p)]));
let eager = 8;
---
<Layout title="Gallery" description="研究室の活動・発表で使われた画像のアーカイブ" bare hideToc>
  <script is:inline>document.documentElement.classList.add("js-reveal");</script>

  <div class="gallery-page">
    <header class="gallery-page__head">
      <div class="sect">
        <h1 class="sect__en">Gallery</h1>
        <p class="sect__ja">研究室の記録 <span class="gallery-page__count"><span data-count-total>{total}</span> 枚</span></p>
      </div>
      {groups.length > 1 && (
        <YearJump
          class="gallery-page__select"
          sections=".gal-group"
          options={groups.map((gr) => ({ id: gr.id, label: gr.label === "Undated" ? "日付なし" : `${gr.label}年`, count: gr.shots.length, unit: "枚" }))}
        />
      )}
    </header>

    {total > 0 ? (
      groups.map((g) => (
        <section class="gal-group" id={g.id} aria-labelledby={`${g.id}-label`}>
          <h2 class="gal-group__label" id={`${g.id}-label`}>
            <span class="gal-group__name">{g.label}</span>
            {g.sub && <span class="gal-group__sub">{g.sub}</span>}
            <span class="gal-group__n"><span data-count-for={g.id}>{g.shots.length}</span> 枚</span>
          </h2>
          <div class="pin">
            {g.shots.map((p) => (
              <a class="pin__cell" href={p.href} style={`aspect-ratio:${ratioOf.get(p)}`}>
                <img
                  src={tileOf.get(p)?.src ?? p.src}
                  srcset={tileOf.get(p)?.srcset ?? p.srcset}
                  sizes="(max-width: 560px) 46vw, (max-width: 1100px) 30vw, 260px"
                  alt={p.alt}
                  loading={eager-- > 0 ? "eager" : "lazy"}
                  decoding="async"
                />
                <span class="pin__cap" aria-hidden="true">
                  {p.day && <span class="pin__day">{p.day}</span>}
                  <span class="pin__title">{p.title}</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
    ) : (
      <p class="gallery-page__empty">まだ画像がありません。</p>
    )}
  </div>
</Layout>

<script>
  // Each cell reserves its height (aspect-ratio), so native lazy-loading only
  // fetches images as they scroll near. Fade each in when it lands; a photo
  // that fails to load is removed so the album has no holes. `js-reveal`
  // gates the start state, so with JS off every image is simply visible.
  const imgs = document.querySelectorAll<HTMLImageElement>(".pin__cell img");
  const done = (img: HTMLImageElement) => img.classList.add("is-loaded");
  // Keep the counts honest: recount after a photo is dropped (and hide a
  // year that ends up empty).
  let recountQueued = false;
  const recount = () => {
    recountQueued = false;
    let total = 0;
    document.querySelectorAll<HTMLElement>(".gal-group").forEach((g) => {
      const n = g.querySelectorAll(".pin__cell").length;
      total += n;
      document.querySelectorAll(`[data-count-for="${g.id}"]`).forEach((el) => (el.textContent = String(n)));
      document.querySelectorAll(`[data-yj-count="${g.id}"]`).forEach((el) => (el.textContent = String(n)));
      if (n === 0) {
        g.hidden = true;
        document.querySelector(`[data-yj-item="${g.id}"]`)?.setAttribute("hidden", "");
      }
    });
    const t = document.querySelector("[data-count-total]");
    if (t) t.textContent = String(total);
  };
  const drop = (img: HTMLImageElement) => {
    img.closest(".pin__cell")?.remove();
    if (!recountQueued) {
      recountQueued = true;
      requestAnimationFrame(recount);
    }
  };

  imgs.forEach((img) => {
    if (img.complete) {
      if (img.naturalWidth > 0) done(img);
      else drop(img);
    } else {
      img.addEventListener("load", () => done(img), { once: true });
      img.addEventListener("error", () => drop(img), { once: true });
    }
  });
</script>
