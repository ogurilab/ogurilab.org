---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import options from "virtual:cosense-theme-lab/options";
import Layout from "../components/Layout.astro";
import LogoMark from "../components/LogoMark.astro";
import YearJump from "../components/YearJump.astro";
import { hasTag, loadStructure, path } from "@cosense-site-kit/theme-utils";
import { newsSummary } from "../lib/news";
import { responsiveImage } from "../lib/photos";

// News archive as one timeline: every #news page on a single page (no
// pagination), newest first, grouped by year. Each year has a label on the
// left that stays in view while its posts scroll past, and a row of year
// chips at the top jumps between years. The rows reuse the home page's
// timeline list (.postlist): a line down the left with a dot per post. The
// newest year keeps the home page's cyan-to-grey line; older years are grey.
// Only /news is emitted (later pages of the old pagination are gone).
export const getStaticPaths: GetStaticPaths = async () => {
  const structure = await loadStructure();
  const tag = structure.posts?.tag ?? options.newsTag;
  const all = await getCollection("pages");
  const items = all
    .filter((e) => hasTag(e.data.tags, tag))
    .map((e) => newsSummary(e))
    .sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0));
  return [{ params: { page: undefined }, props: { items, tag } }];
};

type NewsItem = ReturnType<typeof newsSummary>;
const { items, tag } = Astro.props as { items: NewsItem[]; tag: string };

// Grouped by 年度 (the Japanese academic / fiscal year, April–March): a post
// dated 2026-03-23 belongs to 2025年度.
const fyOf = (d: Date) => (d.getMonth() >= 3 ? d.getFullYear() : d.getFullYear() - 1);
const byYear = new Map<string, NewsItem[]>();
for (const n of items) {
  const y = n.date ? String(fyOf(n.date)) : "—";
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(n);
}
const years = [...byYear.entries()].map(([y, list]) => ({
  id: y === "—" ? "undated" : `fy${y}`,
  label: y === "—" ? "日付なし" : y,
  chip: y === "—" ? "日付なし" : `${y}年度`,
  list,
}));
const pad = (n: number) => String(n).padStart(2, "0");
---
<Layout title="News" description="ニュース・お知らせ" wide hideToc>
  <div class="news-page">
    <header class="news-page__head">
      <div class="sect">
        <h1 class="sect__en">News</h1>
        <p class="sect__ja">研究室の活動 <span class="news-page__count">{items.length} 件</span></p>
      </div>
      {years.length > 1 && (
        <YearJump
          class="news-page__years"
          label="年度から探す"
          sections=".news-year"
          options={years.map((y) => ({ id: y.id, label: y.chip, count: y.list.length }))}
        />
      )}
    </header>

    {items.length === 0 ? (
      <p class="summary">
        ニュースは <code>#{tag}</code> タグ付きのページとして公開してください。
      </p>
    ) : (
      <div class="news-years">
      {years.map((y, yi) => (
        <section class="gal-group news-year" id={y.id} aria-labelledby={`${y.id}-label`}>
          <h2 class="gal-group__label" id={`${y.id}-label`}>
            <span class="gal-group__name">{y.label}</span>
            <span class="gal-group__n">{y.id !== "undated" && "年度・"}{y.list.length} 件</span>
          </h2>
          <ul class:list={["postlist", { "postlist--past": yi > 0 }]}>
            {y.list.map((n) => {
              const thumb = n.image ? responsiveImage(n.image) : null;
              const tags = n.tags.filter((t) => t !== tag);
              return (
                <li class="postlist__item">
                  {n.date ? (
                    <time class="postlist__date" datetime={n.date.toISOString()}>
                      <span class="postlist__md">{pad(n.date.getMonth() + 1)}.{pad(n.date.getDate())}</span>
                    </time>
                  ) : (
                    <span class="postlist__date postlist__date--none" aria-hidden="true"></span>
                  )}
                  <a class="postlist__thumb" href={path(n.slug)} aria-hidden="true" tabindex="-1">
                    {thumb ? (
                      <img src={thumb.src} srcset={thumb.srcset} sizes="76px" alt="" loading="lazy" decoding="async" />
                    ) : (
                      <span class="postlist__ph"><LogoMark class="thumb-mark" /></span>
                    )}
                  </a>
                  <div class="postlist__body">
                    <a class="postlist__title" href={path(n.slug)}>{n.title}</a>
                    {n.description && n.description.slice(0, 16) !== n.title.slice(0, 16) && (
                      <p class="postlist__summary">{n.description}</p>
                    )}
                    {tags.length > 0 && (
                      <div class="postlist__meta">
                        {tags.map((t) => <span class="postlist__tag">#{t}</span>)}
                      </div>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
      </div>
    )}
  </div>
</Layout>

