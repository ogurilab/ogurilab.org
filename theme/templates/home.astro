---
import options from "virtual:cosense-theme-lab/options";
import site from "virtual:cosense-site-kit/site";
import { getCollection } from "astro:content";
import Layout from "../components/Layout.astro";
import ShaderHero from "../components/ShaderHero.astro";
import { loadStructure, loadTitleToSlug, navHref, path } from "@cosense-site-kit/theme-utils";
import { firstParagraph } from "../lib/content";

// A single-screen portal: no scroll. The individual pages already carry the
// depth (About, News, Members, Publications, Contact, Join), so the home page's
// only job is to state who the lab is and hand visitors off to those pages.

const structure = await loadStructure();
const cfg = structure as typeof structure & { join?: { page?: string } };
const all = await getCollection("pages");
const titleToSlug = await loadTitleToSlug();

type Entry = (typeof all)[number];
const find = (name?: string): Entry | undefined =>
  name ? all.find((e) => e.data.title === name || e.data.slug === name) : undefined;

const siteTitle = options.siteTitle ?? site?.title ?? "Home";
const siteDescription = options.siteDescription ?? site?.description;

// The site title doubles as the header logo ("dclab | デジタルカルチャー研究室").
// Split on the pipe: brand → eyebrow, full name → the display title.
const [brand, ...restTitle] = siteTitle.split("|").map((s) => s.trim());
const displayTitle = restTitle.length > 0 ? restTitle.join(" ") : brand;
const eyebrow = options.affiliation ?? (restTitle.length > 0 ? brand : undefined);

// One-line mission, taken from the Welcome/home page's last paragraph (its punchy
// statement), falling back to the first paragraph or the site description.
const homeEntry = find(structure.home?.page ?? options.homePage);
const paragraphs = (homeEntry?.data.blocks ?? [])
  .filter((b) => b.type === "paragraph")
  .map((b) => firstParagraph([b]))
  .filter(Boolean);
const mission = paragraphs.at(-1) ?? siteDescription ?? "";

// Destinations: the site nav, plus Join when that page exists. Each gets a short
// Japanese sublabel for warmth; unknown labels just show the label alone.
const navItems = structure.nav.length > 0 ? structure.nav : options.nav;
const joinEntry = find(cfg.join?.page ?? "Join") ?? find("学生の方へ");

const SUBLABEL: Record<string, string> = {
  about: "研究室について",
  news: "最近の活動",
  members: "メンバー",
  publications: "業績・論文",
  contact: "お問い合わせ・共同研究",
  join: "学生の方へ",
};

interface Dest {
  label: string;
  sub?: string;
  href: string;
}
const destinations: Dest[] = navItems.map((item) => ({
  label: item.label,
  sub: SUBLABEL[item.label.toLowerCase()],
  href: navHref(item, titleToSlug),
}));
// Add Join if it isn't already in the nav.
if (joinEntry && !destinations.some((d) => d.label.toLowerCase() === "join")) {
  destinations.push({ label: "Join", sub: SUBLABEL.join, href: path(joinEntry.data.slug) });
}
---
<Layout title={siteTitle} description={siteDescription} bare hideToc hideFooter>
  <section class="portal" data-pagefind-body>
    <ShaderHero />
    <div class="portal__scrim" aria-hidden="true"></div>

    <div class="portal__inner">
      <header class="portal__intro">
        {eyebrow && <p class="portal__eyebrow">{eyebrow}</p>}
        <h1 class="portal__title">{displayTitle}</h1>
        {mission && <p class="portal__mission">{mission}</p>}
      </header>

      <nav class="portal__nav" aria-label="サイト案内">
        <ul class="portal__grid">
          {destinations.map((d, i) => (
            <li class="portal__cell">
              <a class="portal__dest" data-magnetic="0.15" href={d.href}>
                <span class="portal__no">{String(i + 1).padStart(2, "0")}</span>
                <span class="portal__label">{d.label}</span>
                {d.sub && <span class="portal__sub">{d.sub}</span>}
                <span class="portal__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</Layout>
