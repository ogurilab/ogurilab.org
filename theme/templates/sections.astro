---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { path, slugifyHeading } from "@cosense-site-kit/theme-utils";
import PageContent from "@cosense-site-kit/theme-utils/components/PageContent.astro";
import Layout from "../components/Layout.astro";
import LogoMark from "../components/LogoMark.astro";
import YearSelect from "../components/YearSelect.astro";
import { responsiveImage } from "../lib/photos";
import { ordinal, splitSections } from "../lib/sections";
import { inlineText } from "../lib/content";
import { newsSummary } from "../lib/news";
import options from "virtual:cosense-theme-lab/options";
import { hasTag, loadStructure } from "@cosense-site-kit/theme-utils";
import type { CosenseBlock, InlineNode } from "@cosense-site-kit/core";

// A landing-style template: the page body is split into sections and each one
// is laid out from what it contains (see lib/sections.ts). Not About-specific —
// assign it to any page that reads as a stack of sections, either from the
// `.site` `templates:` mapping or with a `#template/sections` tag.

// Rendered widths, for picking a srcset candidate. A section figure spans the
// column, or a little under half of it in the two-column hero; a card tracks
// the ~15rem minimum of its grid.
const FIGURE_SIZES = "(max-width: 60rem) 100vw, 45vw";
const CARD_SIZES = "(max-width: 40rem) 100vw, 22rem";

interface Props {
  entry: CollectionEntry<"pages">;
}

const { entry } = Astro.props;
const page = entry.data;
const sections = splitSections(page.blocks);

// Card items name a Cosense page; the card borrows that page's first image and
// summary so the author only has to write `[Page title]`. Same lookup the
// members template uses for avatars.
const all = await getCollection("pages");
const linked = new Map<string, { slug: string; image?: string; summary?: string }>();
for (const e of all) {
  if (linked.has(e.data.title)) continue;
  linked.set(e.data.title, {
    slug: e.data.slug,
    image: e.data.image ?? undefined,
    summary: usableSummary(e.data.summary, e.data.title),
  });
}

// ----- Tidying passes on top of the generic layouts -----------------------

// A paragraph that is nothing but tags (`#template/sections`, `#publish`) is
// page metadata, not content — drop it wherever it lands.
const isTagLine = (b: CosenseBlock) =>
  b.type === "paragraph" &&
  b.children.every((n) => n.type === "tag" || (n.type === "text" && !n.value.trim()));
for (const s of sections) s.blocks = s.blocks.filter((b) => !isTagLine(b));

// A lead that is only tags ("#publish #no-date") is the page's tag line.
for (const s of sections) if (s.lead && /^(#\S+\s*)+$/.test(s.lead.trim())) s.lead = undefined;
// "OurMission" → "Our Mission" (two English words written without a space).
for (const s of sections) if (/^[A-Z][a-z]+[A-Z][a-z]+$/.test(s.title)) s.title = s.title.replace(/([a-z])([A-Z])/, "$1 $2");

// Per-section display mode on top of the generic layout:
//   statement — prose that is one sub-heading + its paragraph
//   numbered  — prose that is two or more sub-heading + paragraph pairs
//   chips     — "cards" that link nowhere (e.g. "Unity, Blender, …")
//   links     — cards without any pictures: a row of plain links instead of
//               empty picture frames
type Mode = "statement" | "links" | undefined;
const modeOf = new Map<(typeof sections)[number], Mode>();
const statementOf = new Map<(typeof sections)[number], { head: string; body: string }>();
const blankPara = (b: CosenseBlock) =>
  b.type === "paragraph" && b.children.every((n) => n.type === "text" && !n.value.trim());
for (const s of sections) {
  if (s.layout === "prose") {
    const real = s.blocks.filter((b) => !blankPara(b));
    const pairs: { title: string; body: string }[] = [];
    let ok = real.length >= 2 && real.length % 2 === 0;
    for (let i = 0; ok && i < real.length; i += 2) {
      const h = real[i];
      const p = real[i + 1];
      if (h.type !== "heading" || p.type !== "paragraph") ok = false;
      else pairs.push({ title: inlineText(h.children).trim(), body: inlineText(p.children).trim() });
    }
    if (ok && pairs.length === 1) {
      modeOf.set(s, "statement");
      statementOf.set(s, { head: pairs[0].title, body: pairs[0].body });
    } else if (ok && pairs.length >= 2) {
      s.layout = "numbered";
      s.items = pairs;
      s.blocks = [];
    }
  } else if (s.layout === "cards") {
    // nothing to link to (no URL, and no published page by that name)
    if (s.items.every((i) => !i.href && !(i.page && linked.get(i.page)))) {
      s.layout = "chips";
      s.items = s.items
        .flatMap((i) => `${i.title}${i.body ?? ""}`.split(/\s*[,、]\s*/))
        .map((t) => t.trim())
        .filter((t) => t && !/^etc\.?$/i.test(t))
        .map((title) => ({ title }));
    } else if (s.items.every((i) => !(i.page && linked.get(i.page)?.image))) {
      modeOf.set(s, "links");
    }
  }
}
// Section numbers (01, 02, …) for pages made of several titled sections.
const titled = sections.filter((s) => s.title);
const numberOf = new Map(titled.map((s, i) => [s, String(i + 1).padStart(2, "0")]));
const showNumbers = titled.length >= 3;

// Link labels for the "links" row: nav pages get their Japanese name.
const LINK_JA: Record<string, string> = {
  research: "研究",
  members: "メンバー",
  "members data": "メンバー",
  publications: "業績",
  news: "ニュース",
  contact: "お問い合わせ",
  about: "研究室について",
  gallery: "ギャラリー",
};

const pageLinksIn = (nodes: InlineNode[]): string[] => {
  const out: string[] = [];
  const walk = (ns: InlineNode[]) => {
    for (const n of ns) {
      if (n.type === "pageLink") out.push(n.title);
      else if ("children" in n && Array.isArray(n.children)) walk(n.children as InlineNode[]);
    }
  };
  walk(nodes);
  return out;
};

// "Works" lists: a prose section made of sub-headings (年度) each followed by
// `[name] [title]` lines. Drawn as a year-switchable list of titles with the
// author's name under each, instead of a raw bullet list of links.
interface Work { name: string; title: string }
interface WorkGroup { label: string; works: Work[] }
function worksOf(blocks: CosenseBlock[]): WorkGroup[] | null {
  const groups: WorkGroup[] = [];
  let current: WorkGroup | null = null;
  for (const b of blocks) {
    if (b.type === "heading") {
      current = { label: inlineText(b.children).trim(), works: [] };
      groups.push(current);
      continue;
    }
    if (b.type === "list" && current) {
      const links = pageLinksIn(b.children);
      if (links.length < 2) return null;
      current.works.push({ name: links[0], title: links[1] });
      continue;
    }
    return null; // anything else: leave the section as prose
  }
  const ok = groups.length > 0 && groups.every((g) => g.works.length > 0);
  return ok ? groups : null;
}

// "See the publications" sections: a prose section whose only content is one
// short line linking to a page. Rendered as a short list of the latest talks (news posts
// that report a presentation) plus a proper "see all" link.
function soleLinkOf(blocks: CosenseBlock[]): string | null {
  // blank lines don't count
  const real = blocks.filter(
    (b) => !(b.type === "paragraph" && b.children.every((n) => n.type === "text" && !n.value.trim())),
  );
  if (real.length !== 1) return null;
  const only = real[0];
  if (only.type !== "paragraph" && only.type !== "list") return null;
  // one short line pointing at one page ("すべての業績は [Publications] に…")
  const links = pageLinksIn(only.children);
  if (links.length !== 1) return null;
  if (inlineText(only.children).trim().length > 60) return null;
  return links[0];
}
const structure = await loadStructure();
const newsTag = structure.posts?.tag ?? options.newsTag;
const recentTalks = all
  .filter((e) => hasTag(e.data.tags, newsTag))
  .map((e) => newsSummary(e))
  .filter((n) => /発表/.test(n.title))
  .sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0))
  .slice(0, 4);
const pad = (n: number) => String(n).padStart(2, "0");

// Not every page's summary earns a place on a card:
//   - a page whose first line is an image or a bare link has that raw
//     `[https://gyazo.com/…]` markup as its summary, which reads as noise;
//   - plenty of posts open with a sentence that restates their title, which
//     would print the same line twice. Same guard the home news list uses.
function usableSummary(summary: string | null | undefined, title: string): string | undefined {
  const text = summary?.trim();
  if (!text || /^\[?https?:\/\//.test(text)) return undefined;
  if (text.slice(0, 16) === title.slice(0, 16)) return undefined;
  // "RinkuTwilightにて…を行いました" under a title that already says so
  const head = text.replace(/[。．.]$/, "").slice(0, 18);
  if (head.length >= 10 && title.includes(head.slice(-10))) return undefined;
  return text;
}
---

<Layout title={page.title} sourceUrl={page.sourceUrl} description={page.summary} image={page.image} ogType="article" wide>
  <article data-pagefind-body>
    <header class="page-header">
      {page.draft && <span class="draft-badge">Draft · preview only</span>}
      <h1>{page.title}</h1>
    </header>

    {sections.map((section) => (
      <section class:list={["sx", `sx--${section.layout}`]}>
        {section.title && (
          <div class="sx__head">
            {showNumbers && <p class="sx__no" aria-hidden="true">{numberOf.get(section)}</p>}
            <h2 id={slugifyHeading(section.title)}>{section.title}</h2>
            {section.lead && <p class="sx__lead">{section.lead}</p>}
          </div>
        )}

        {/* Every layout uses this same body; `hero` differs only in that CSS
            puts the prose and the figures side by side. */}
        <div class="sx__body">
          {(() => {
            if (modeOf.get(section) === "statement") {
              const st = statementOf.get(section)!;
              return (
                <div class="sx-statement">
                  <p class="sx-statement__head">{st.head}</p>
                  <p class="sx-statement__body">{st.body}</p>
                </div>
              );
            }
            const works = section.layout === "prose" ? worksOf(section.blocks) : null;
            const sole = section.layout === "prose" ? soleLinkOf(section.blocks) : null;
            if (works) {
              const total = works.reduce((n, g) => n + g.works.length, 0);
              return (
                <div class="works">
                  {works.length > 1 && (
                    <YearSelect
                      class="works__years"
                      label="表示する年度"
                      value="0"
                      options={[
                        ...works.map((g, gi) => ({ value: String(gi), label: g.label, count: g.works.length })),
                        { value: "all", label: "すべての年度", count: total },
                      ]}
                    />
                  )}
                  {works.map((g, gi) => (
                    <div class="works__group" data-works-group={gi} hidden={gi > 0 && works.length > 1}>
                      <h3 class="works__label">{g.label}<span>{g.works.length} 件</span></h3>
                      <ul class="works__list">
                        {g.works.map((w) => {
                          const t = linked.get(w.title);
                          const n = linked.get(w.name);
                          return (
                            <li class="works__item">
                              {t ? (
                                <a class="works__title" href={path(t.slug)}>{w.title}</a>
                              ) : (
                                <span class="works__title">{w.title}</span>
                              )}
                              {n ? (
                                <a class="works__name" href={path(n.slug)}>{w.name}</a>
                              ) : (
                                <span class="works__name">{w.name}</span>
                              )}
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  ))}
                </div>
              );
            }
            if (sole) {
              const target = linked.get(sole);
              return (
                <div class="talks">
                  {/publication|業績|発表/i.test(sole) && recentTalks.length > 0 && (
                    <ul class="talks__list">
                      {recentTalks.map((n) => (
                        <li class="talks__item">
                          {n.date && (
                            <time class="talks__date" datetime={n.date.toISOString()}>
                              {n.date.getFullYear()}.{pad(n.date.getMonth() + 1)}
                            </time>
                          )}
                          <a class="talks__title" href={path(n.slug)}>{n.title}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                  {target && (
                    <a class="more talks__more" href={path(target.slug)}>
                      すべての{/publication/i.test(sole) ? "業績" : sole}を見る<span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              );
            }
            return section.blocks.length > 0 ? <PageContent blocks={section.blocks} /> : null;
          })()}

          {section.images.length > 0 && (
            <div class="sx__figures">
              {section.images.map((img) => {
                const figure = responsiveImage(img.url);
                const picture = (
                  <img
                    src={figure.src}
                    srcset={figure.srcset}
                    sizes={FIGURE_SIZES}
                    alt={img.alt ?? ""}
                    loading="lazy"
                    decoding="async"
                  />
                );
                return (
                  <figure class="sx__figure">
                    {/* Cosense lets an image carry a link (`[<image> <url>]`);
                        keep it, the way the gallery and home page do. */}
                    {img.href ? <a href={img.href}>{picture}</a> : picture}
                  </figure>
                );
              })}
            </div>
          )}

          {section.layout === "numbered" && (
            <ol class:list={["sx__numbered", { "is-plain": showNumbers }]}>
              {section.items.map((item, i) => (
                <li class="sx__num-item">
                  {/* the page already numbers its sections (01, 02 …), so a
                      numbered list inside one only keeps its accent tick */}
                  {!showNumbers && <span class="sx__num" aria-hidden="true">{ordinal(i)}</span>}
                  <div>
                    <p class="sx__num-title">{item.title}</p>
                    {item.body && <p class="sx__num-body">{item.body}</p>}
                  </div>
                </li>
              ))}
            </ol>
          )}

          {modeOf.get(section) === "links" && (
            <ul class="sx-links">
              {section.items.map((item) => {
                const ref = item.page ? linked.get(item.page) : undefined;
                const href = item.href ?? (ref ? path(ref.slug) : undefined);
                const ja = LINK_JA[item.title.trim().toLowerCase()];
                const label = ja ?? item.title.replace(/\s*[（(]\d{4}-\d{2}-\d{2}[）)]\s*$/, "");
                return href ? (
                  <li>
                    <a class="sx-cta" href={href} {...(item.href ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                      <span class="sx-cta__title">{label}</span>
                      {ja && <span class="sx-cta__text">{item.title.replace(/\s*data$/i, "")}</span>}
                      <span class="sx-cta__arrow" aria-hidden="true">→</span>
                    </a>
                  </li>
                ) : null;
              })}
            </ul>
          )}

          {section.layout === "cards" && modeOf.get(section) !== "links" && (
            <div class:list={["sx__cards-wrap", { "is-slider": section.items.length > 3 }]} data-cards-slider={section.items.length > 3 ? "" : undefined}>
            {section.items.length > 3 && (
              <div class="sx__slide-nav">
                <button type="button" class="sx__slide-btn" data-dir="-1" aria-label="前へ" disabled>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
                </button>
                <button type="button" class="sx__slide-btn" data-dir="1" aria-label="次へ">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                </button>
              </div>
            )}
            <ul class="sx__cards">
              {section.items.map((item) => {
                const ref = item.page ? linked.get(item.page) : undefined;
                const href = item.href ?? (ref ? path(ref.slug) : undefined);
                const thumb = ref?.image ? responsiveImage(ref.image) : undefined;
                const body = item.body ?? ref?.summary;
                const card = (
                  <Fragment>
                    <span class="sx__card-thumb">
                      {thumb ? (
                        <img
                          src={thumb.src}
                          srcset={thumb.srcset}
                          sizes={CARD_SIZES}
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span class="sx__card-ph" aria-hidden="true">
                          <LogoMark class="thumb-mark" />
                        </span>
                      )}
                    </span>
                    <span class="sx__card-body">
                      <span class="sx__card-title">{item.title.replace(/\s*[（(]\d{4}-\d{2}-\d{2}[）)]\s*$/, "")}</span>
                      {body && <span class="sx__card-text">{body}</span>}
                    </span>
                  </Fragment>
                );
                return (
                  <li class="sx__card">
                    {href ? (
                      <a
                        href={href}
                        class="sx__card-link"
                        target={item.href ? "_blank" : undefined}
                        rel={item.href ? "noopener noreferrer" : undefined}
                      >
                        {card}
                      </a>
                    ) : (
                      <span class="sx__card-link is-static">{card}</span>
                    )}
                  </li>
                );
              })}
            </ul>
            </div>
          )}

          {section.layout === "chips" && (
            <ul class="sx__chips">
              {section.items.map((item) => (
                <li class="sx__chip">{item.title}</li>
              ))}
            </ul>
          )}
        </div>
      </section>
    ))}
  </article>
</Layout>

<script>
  // 年度 pulldown on a works list: show one year (or all), fading it in.
  function initWorks(): void {
    document.querySelectorAll<HTMLElement>(".works").forEach((root) => {
      if (root.dataset.wired) return;
      root.dataset.wired = "1";
      const groups = [...root.querySelectorAll<HTMLElement>("[data-works-group]")];
      root.addEventListener("mf-change", (e) => {
        const v = (e as CustomEvent<{ value: string }>).detail.value;
        root.classList.toggle("is-all", v === "all");
        groups.forEach((g) => {
          g.hidden = v !== "all" && g.dataset.worksGroup !== v;
          g.classList.remove("is-in");
          void g.offsetWidth;
          if (!g.hidden) g.classList.add("is-in");
        });
      });
    });
  }
  // Card rows with more than three cards: three at a time, slid sideways
  // with the arrow buttons (or a swipe / trackpad); arrows dim at the ends.
  function initCardSliders(): void {
    document.querySelectorAll<HTMLElement>("[data-cards-slider]").forEach((wrap) => {
      if (wrap.dataset.ready) return;
      wrap.dataset.ready = "1";
      const track = wrap.querySelector<HTMLElement>(".sx__cards");
      const btns = [...wrap.querySelectorAll<HTMLButtonElement>(".sx__slide-btn")];
      if (!track) return;
      const update = () => {
        const thumb = track.querySelector<HTMLElement>(".sx__card-thumb");
        if (thumb) wrap.style.setProperty("--thumb-mid", `${thumb.offsetHeight / 2}px`);
        const max = track.scrollWidth - track.clientWidth - 2;
        btns[0].disabled = track.scrollLeft <= 2;
        btns[1].disabled = track.scrollLeft >= max;
      };
      btns.forEach((b) =>
        b.addEventListener("click", () => {
          const card = track.querySelector<HTMLElement>(".sx__card");
          const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
          const step = card ? card.offsetWidth + gap : track.clientWidth;
          track.scrollBy({ left: step * Number(b.dataset.dir), behavior: "smooth" });
        }),
      );
      track.addEventListener("scroll", () => requestAnimationFrame(update), { passive: true });
      window.addEventListener("resize", update);
      update();
    });
  }
  initCardSliders();
  document.addEventListener("astro:page-load", initCardSliders);
  initWorks();
  document.addEventListener("astro:page-load", initWorks);
</script>

<style>
  /* Section rhythm. Generous vertical space is what makes a stack of sections
     read as a landing page rather than an article. */
  .sx {
    margin-top: clamp(3rem, 8vw, 5.5rem);
  }
  .sx:first-of-type {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .sx__head {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  /* Section number: a small mono numeral on a short accent rule, above the
     heading — gives the stack of sections a quiet table-of-contents rhythm. */
  .sx__no {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color-accent-bright);
  }
  .sx__no::after {
    content: "";
    width: 2rem;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
  }
  .sx__head h2 {
    margin: 0;
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    letter-spacing: 0.01em;
  }
  /* The one-line introduction under a heading. */
  .sx__lead {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  /* ----- Body ----- */

  /* Space only between parts that are actually present, so a section with no
     prose doesn't get a stray gap under its heading. `:global` reaches
     PageContent's root, which carries its own scope rather than this one's. */
  .sx__body :global(.page-content) + *,
  .sx__figures + * {
    margin-top: 1.5rem;
  }
  .sx__body :global(.page-content > :first-child) {
    margin-top: 0;
  }

  /* ----- Figures ----- */

  .sx__figure {
    margin: 0;
  }
  .sx__figure a {
    display: block;
  }
  .sx__figure img {
    display: block;
    width: 100%;
    /* Fill the column, but never let a tall image take the section over — a 3:4
       photo would otherwise render a full screen high and dwarf the prose next
       to it. The theme caps body images the same way (.page-content img); the
       difference is that a figure here is a designed slot, so the overflow is
       cropped rather than shrinking the image away from the column edge. */
    max-height: min(56vh, 26rem);
    object-fit: cover;
    border-radius: 8px;
    background: var(--color-bg-hover);
  }
  .sx__figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0.75rem;
  }

  /* Hero figures get a grown outline rather than a drawn one. Every corner is
     rounded, no two by the same amount, and none far enough to read as a
     deliberate arc — the irregularity is what makes it organic. Two large
     matching sweeps, which is where this started, look designed instead:
     the eye finds the symmetry and stops seeing a shape. Consecutive figures
     use a different set again, so a row never repeats. */
  /* `min(length, percentage)` per corner, which is what makes the outline hold
     up at any aspect ratio:
       - a bare percentage resolves against the box, so one rule became a flat
         lozenge on a panorama and a tall dome on a portrait;
       - a bare length is stable but swallows a short box whole — on a 3:1 image
         the two left corners alone ate most of the height.
     The length sets the shape at ordinary sizes; the percentage only takes over
     when the box is too small or too flat to carry it. Because each cap is
     proportional to its own radius, a clamped outline shrinks evenly instead of
     distorting. A single value per corner (no `/`) lets the cap answer to width
     and height independently, so a wide box flattens its corners by itself. */
  .sx--hero .sx__figure img {
    border-radius: min(4.5rem, 17%) min(2.5rem, 10%) min(3.75rem, 14%) min(3rem, 11%);
  }
  .sx--hero .sx__figure:nth-child(even) img {
    border-radius: min(2.75rem, 10%) min(4rem, 15%) min(2.5rem, 9%) min(4.75rem, 18%);
  }

  /* The shape drifts on a very slow cycle — imperceptible frame to frame, but
     enough that the image never quite settles. The two durations are close but
     not multiples, so figures beside each other stay out of phase. The resting
